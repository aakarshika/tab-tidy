{
  "manifest_version": 3,
  "name": "Tab Tidy",
  "version": "0.0.1",
  "description": "Merges windows, deduplicates, groups by domain, and enforces your pinned anchor set.",
  "homepage_url": "https://github.com/aakarshika/tab-tidy",
  "permissions": ["tabs", "tabGroups", "storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tab Tidy"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
